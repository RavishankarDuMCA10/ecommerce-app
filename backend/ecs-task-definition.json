{
  "family": "ecommerce-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID_PLACEHOLDER:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID_PLACEHOLDER:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "ecommerce-backend",
      "image": "BACKEND_IMAGE",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "secrets": [
        {
          "name": "MONGO_URI",
          "valueFrom": "arn:aws:ssm:us-east-1:ACCOUNT_ID_PLACEHOLDER:parameter/ecommerce/MONGO_URI"
        },
        {
          "name": "MONGO_DB",
          "valueFrom": "arn:aws:ssm:us-east-1:ACCOUNT_ID_PLACEHOLDER:parameter/ecommerce/MONGO_DB"
        },
        {
          "name": "JWT_AUTH_SECRET_KEY",
          "valueFrom": "arn:aws:ssm:us-east-1:ACCOUNT_ID_PLACEHOLDER:parameter/ecommerce/JWT_AUTH_SECRET_KEY"
        },
        {
          "name": "API_KEY_CLOUDINARY",
          "valueFrom": "arn:aws:ssm:us-east-1:ACCOUNT_ID_PLACEHOLDER:parameter/ecommerce/API_KEY_CLOUDINARY"
        },
        {
          "name": "API_SECRET_CLOUDINARY",
          "valueFrom": "arn:aws:ssm:us-east-1:ACCOUNT_ID_PLACEHOLDER:parameter/ecommerce/API_SECRET_CLOUDINARY"
        },
        {
          "name": "CLOUD_NAME_CLOUDINARY",
          "valueFrom": "arn:aws:ssm:us-east-1:ACCOUNT_ID_PLACEHOLDER:parameter/ecommerce/CLOUD_NAME_CLOUDINARY"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ecommerce-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8000/ || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      }
    }
  ]
}
